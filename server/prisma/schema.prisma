// Rentora database schema (PostgreSQL + Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ItemCondition {
  BRAND_NEW
  LIKE_NEW
  GOOD
  FAIR
}

enum ListingStatus {
  ACTIVE
  PAUSED
  REMOVED // removed by an admin
  DELETED // soft-deleted by the owner (kept for booking history)
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  ACTIVE
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  SIMULATED_PAID // test-mode only: no real money is moved
  SIMULATED_REFUNDED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_ACTIVE
  BOOKING_COMPLETED
  NEW_MESSAGE
  NEW_REVIEW
  SYSTEM
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String? // null for accounts created with a social login
  phone              String
  profileImage       String?
  bio                String?
  province           String?
  city               String
  district           String?
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  // Denormalized rating as an owner (updated when reviews are created)
  ratingAvg          Float      @default(0)
  ratingCount        Int        @default(0)
  notifyBookings     Boolean    @default(true)
  notifyMessages     Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  listings           Listing[]
  rentals            Booking[]                 @relation("RenterBookings")
  ownedBookings      Booking[]                 @relation("OwnerBookings")
  favorites          Favorite[]
  participants       ConversationParticipant[]
  messages           Message[]
  reviewsWritten     Review[]                  @relation("ReviewsWritten")
  reviewsReceived    Review[]                  @relation("ReviewsReceived")
  notifications      Notification[]
  reports            Report[]
  oauthAccounts      OAuthAccount[]

  @@index([city])
}

/// A social login (Google, Facebook, GitHub, ...) connected to a user.
model OAuthAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String // provider key, e.g. "google"
  providerUserId String // the provider's stable user id ("sub" / "id")
  email          String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider]) // one account per provider per user
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String    // lucide icon name used by the client
  image       String?
  description String?
  sortOrder   Int       @default(0)
  listings    Listing[]
}

model Listing {
  id              String        @id @default(cuid())
  ownerId         String
  categoryId      String
  title           String
  description     String
  subcategory     String?
  dailyPrice      Int // IDR, whole rupiah
  weeklyPrice     Int?
  monthlyPrice    Int?
  securityDeposit Int           @default(0)
  condition       ItemCondition
  province        String
  city            String
  district        String?
  address         String // pickup location description (no exact street address required)
  pickupAvailable   Boolean     @default(true)
  deliveryAvailable Boolean     @default(false)
  deliveryFee       Int         @default(0)
  minRentalDays   Int           @default(1)
  maxRentalDays   Int?
  status          ListingStatus @default(ACTIVE)
  ratingAvg       Float         @default(0)
  reviewCount     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner          User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category       Category              @relation(fields: [categoryId], references: [id])
  images         ListingImage[]
  bookings       Booking[]
  favorites      Favorite[]
  reports        Report[]
  blockedDates   ListingBlockedDate[]
  reviews        Review[]
  conversations  Conversation[]

  @@index([status, city])
  @@index([categoryId, status])
  @@index([ownerId])
  @@index([dailyPrice])
  @@index([createdAt])
}

model ListingImage {
  id           String  @id @default(cuid())
  listingId    String
  imageUrl     String
  displayOrder Int     @default(0)
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, displayOrder])
}

// Date ranges the owner has marked as unavailable (inclusive).
model ListingBlockedDate {
  id        String   @id @default(cuid())
  listingId String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, startDate])
}

model Booking {
  id                  String            @id @default(cuid())
  listingId           String
  renterId            String
  ownerId             String
  startDate           DateTime          @db.Date // inclusive
  endDate             DateTime          @db.Date // inclusive
  rentalDays          Int
  fulfillmentMethod   FulfillmentMethod @default(PICKUP)
  // Price snapshot taken when the booking is created. Never recalculated.
  dailyPriceSnapshot  Int
  rentalPriceSnapshot Int
  depositSnapshot     Int
  deliveryFeeSnapshot Int
  totalPrice          Int
  listingTitleSnapshot String
  renterNote          String?
  ownerNote           String?
  status              BookingStatus     @default(PENDING)
  paymentStatus       PaymentStatus     @default(UNPAID)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  renter  User    @relation("RenterBookings", fields: [renterId], references: [id])
  owner   User    @relation("OwnerBookings", fields: [ownerId], references: [id])
  review  Review?

  @@index([listingId, status, startDate, endDate])
  @@index([renterId, status])
  @@index([ownerId, status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Conversation {
  id           String                    @id @default(cuid())
  listingId    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  listing      Listing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, readAt])
}

model Review {
  id             String   @id @default(cuid())
  bookingId      String   @unique // one review per completed booking
  listingId      String
  reviewerId     String
  reviewedUserId String
  rating         Int // 1-5, enforced by validation and a CHECK constraint
  comment        String
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer       User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewedUser   User     @relation("ReviewsReceived", fields: [reviewedUserId], references: [id], onDelete: Cascade)

  @@index([reviewedUserId])
  @@index([listingId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  listingId   String
  reason      String
  description String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  listing     Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
