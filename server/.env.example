# ---- Server ----
NODE_ENV=development
PORT=4000
# Origin of the web client (used for CORS). Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentora?schema=public
# Used by the automated test suite (tests wipe this database!)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentora_test?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Social login (optional) ----
# Each "Continue with ..." button appears only when BOTH its ID and secret are set.
# Register this redirect URI with each provider (replace "google" with the provider name):
#   http://localhost:5173/api/auth/oauth/google/callback
# See README > Social login for step-by-step setup.
# Public URL of the site, used to build redirect URIs. Defaults to the first CLIENT_URL.
APP_URL=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---- Image storage (optional) ----
# If all three are set, uploads go to Cloudinary. Otherwise files are stored on local disk
# in server/uploads and served from /uploads (development fallback).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
