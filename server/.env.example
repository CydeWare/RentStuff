# ---- Server ----
NODE_ENV=development
PORT=4000
# Origin of the web client (used for CORS). Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentora?schema=public
# Used by the automated test suite (tests wipe this database!)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentora_test?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Image storage (optional) ----
# If all three are set, uploads go to Cloudinary. Otherwise files are stored on local disk
# in server/uploads and served from /uploads (development fallback).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
